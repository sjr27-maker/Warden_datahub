    create  table
      "warehouse"."main"."dim_customers__dbt_tmp"
  
    
    as (
      with orders as (
    select
        cust_id,
        min(order_date) as first_order_date,
        max(order_date) as last_order_date,
        count(*) as order_count
    from "warehouse"."main"."stg_orders"
    group by cust_id
)

select
    u.user_id,
    u.email,
    u.country,
    u.signup_date,
    o.first_order_date,
    o.last_order_date,
    coalesce(o.order_count, 0) as order_count
from "warehouse"."main"."stg_users" u
left join orders o on u.user_id = o.cust_id
    );
    
  
[0m06:24:44.819513 [debug] [Thread-2 (]: On model.warden_world.fct_revenue: /* {"app": "dbt", "dbt_version": "1.10.8", "profile_name": "warden_world", "target_name": "dev", "node_id": "model.warden_world.fct_revenue"} */

    

    create  table
      "warehouse"."main"."fct_revenue__dbt_tmp"
  
    
    as (
      with refunds as (
    select order_id, sum(refund_amount_usd) as refunded_usd
    from "warehouse"."main"."stg_refunds"
    group by order_id
)

select
    p.order_id,
    o.cust_id,
    o.order_date,
    p.amount_usd as gross_revenue_usd,
    coalesce(r.refunded_usd, 0) as refunded_usd,
    p.amount_usd - coalesce(r.refunded_usd, 0) as net_revenue_usd
from "warehouse"."main"."stg_payments" p
join "warehouse"."main"."stg_orders" o on p.order_id = o.order_id
left join refunds r on p.order_id = r.order_id
    );
    
  
