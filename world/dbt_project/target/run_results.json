": "2026-08-09T02:45:43.118977Z", "completed_at": "2026-08-09T02:45:43.164055Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.053850412368774414, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.warden_world.dim_customers", "compiled": true, "compiled_code": "with orders as (\n    select\n        cust_id,\n        min(order_date) as first_order_date,\n        max(order_date) as last_order_date,\n        count(*) as order_count\n    from \"warehouse\".\"main\".\"stg_orders\"\n    group by cust_id\n)\n\nselect\n    u.user_id,\n    u.email,\n    u.country,\n    u.signup_date,\n    o.first_order_date,\n    o.last_order_date,\n    coalesce(o.order_count, 0) as order_count\nfrom \"warehouse\".\"main\".\"stg_users\" u\nleft join orders o on u.user_id = o.cust_id", "relation_name": "\"warehouse\".\"main\".\"dim_customers\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-08-09T02:45:43.108176Z", "completed_at": "2026-08-09T02:45:43.123408Z"}, {"name": "execute", "started_at": "2026-08-09T02:45:43.123903Z", "completed_at": "2026-08-09T02:45:43.167510Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.06214261054992676, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.warden_world.fct_revenue", "compiled": true, "compiled_code": "with refunds as (\n    select order_id, sum(refund_amount_usd) as refunded_usd\n    from \"warehouse\".\"main\".\"stg_refunds\"\n    group by order_id\n)\n\nselect\n    p.order_id,\n    o.cust_id,\n    o.order_date,\n    p.amount_usd as gross_revenue_usd,\n    coalesce(r.refunded_usd, 0) as refunded_usd,\n    p.amount_usd - coalesce(r.refunded_usd, 0) as net_revenue_usd\nfrom \"warehouse\".\"main\".\"stg_payments\" p\njoin \"warehouse\".\"main\".\"stg_orders\" o on p.order_id = o.order_id\nleft join refunds r on p.order_id = r.order_id", "relation_name": "\"warehouse\".\"main\".\"fct_revenue\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-08-09T02:45:43.170840Z", "completed_at": "2026-08-09T02:45:43.174859Z"}, {"name": "execute", "started_at": "2026-08-09T02:45:43.175388Z", "completed_at": "2026-08-09T02:45:43.211198Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.04137849807739258, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.warden_world.customer_ltv", "compiled": true, "compiled_code": "select\n    r.cust_id,\n    count(distinct r.order_id) as paid_order_count,\n    sum(r.net_revenue_usd) as lifetime_value_usd,\n    min(r.order_date) as first_paid_date,\n    max(r.order_date) as last_paid_date\nfrom \"warehouse\".\"main\".\"fct_revenue\" r\ngroup by r.cust_id", "relation_name": "\"warehouse\".\"main\".\"customer_ltv\"", "batch_results": null}], "elapsed_time": 0.5572600364685059, "args": {"log_level": "info", "favor_state": false, "indirect_selection": "eager", "upload_to_artifacts_ingest_api": false, "send_anonymous_usage_stats": true, "use_colors": true, "partial_parse_file_diff": true, "exclude": [], "require_explicit_package_overrides_for_builtin_materializations": true, "partial_parse": true, "validate_macro_args": false, "defer": false, "source_freshness_run_project_hooks": true, "skip_nodes_if_on_run_start_fails": false, "print": true, "empty": false, "export_saved_queries": false, "include_saved_query": false, "require_batched_execution_for_custom_microbatch_strategy": false, "project_dir": "/home/sooraj/warden/world/dbt_project", "use_fast_test_edges": false, "write_json": true, "populate_cache": true, "version_check": true, "state_modified_compare_vars": false, "log_file_max_bytes": 10485760, "require_generic_test_arguments_property": true, "macro_debugging": false, "use_colors_file": true, "warn_error_options": {"error": [], "warn": [], "silence": []}, "static_parser": true, "show": false, "invocation_command": "dbt build", "se