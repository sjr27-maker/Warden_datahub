 "2026-08-10T15:48:38.706547Z", "completed_at": "2026-08-10T15:48:38.754770Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.05758237838745117, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.warden_world.dim_customers", "compiled": true, "compiled_code": "with orders as (\n    select\n        cust_id,\n        min(order_date) as first_order_date,\n        max(order_date) as last_order_date,\n        count(*) as order_count\n    from \"warehouse\".\"main\".\"stg_orders\"\n    group by cust_id\n)\n\nselect\n    u.user_id,\n    u.email,\n    u.country,\n    u.signup_date,\n    o.first_order_date,\n    o.last_order_date,\n    coalesce(o.order_count, 0) as order_count\nfrom \"warehouse\".\"main\".\"stg_users\" u\nleft join orders o on u.user_id = o.cust_id", "relation_name": "\"warehouse\".\"main\".\"dim_customers\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-08-10T15:48:38.710791Z", "completed_at": "2026-08-10T15:48:38.717627Z"}, {"name": "execute", "started_at": "2026-08-10T15:48:38.719046Z", "completed_at": "2026-08-10T15:48:38.757999Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.05243396759033203, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.warden_world.fct_revenue", "compiled": true, "compiled_code": "with refunds as (\n    select order_id, sum(refund_amount_usd) as refunded_usd\n    from \"warehouse\".\"main\".\"stg_refunds\"\n    group by order_id\n)\n\nselect\n    p.order_id,\n    o.cust_id,\n    o.order_date,\n    p.amount_usd as gross_revenue_usd,\n    coalesce(r.refunded_usd, 0) as refunded_usd,\n    p.amount_usd - coalesce(r.refunded_usd, 0) as net_revenue_usd\nfrom \"warehouse\".\"main\".\"stg_payments\" p\njoin \"warehouse\".\"main\".\"stg_orders\" o on p.order_id = o.order_id\nleft join refunds r on p.order_id = r.order_id", "relation_name": "\"warehouse\".\"main\".\"fct_revenue\"",